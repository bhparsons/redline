{
  "manifest_version": 3,
  "name": "Redline Review",
  "version": "0.4.76",
  "version_name": "0.4.76 \u00b7 redline-rebuild",
  "description": "Review overlay for local HTML documents, backed by the redline runner.",
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "file:///*"
      ],
      "js": [
        "ports.js",
        "refraction.js",
        "overlay-util.js",
        "overlay-model.js",
        "overlay-theme.js",
        "overlay-anchor.js",
        "overlay-runlog.js",
        "overlay-scope.js",
        "overlay-gutter.js",
        "overlay.js",
        "content.js"
      ],
      "css": [
        "glass.css",
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Redline Review",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
