{
  "name": "redline",
  "version": "0.2.44",
  "description": "Google-Docs-style review layer for static HTML documents, with an agentic revision loop: comment in the browser, a headless Claude session applies the edits under a verified contract, you approve the results.",
  "type": "module",
  "bin": {
    "redline": "./bin/redline.mjs"
  },
  "scripts": {
    "start": "node runner/index.mjs",
    "test": "node test.mjs",
    "test:fast": "node test.mjs --fast",
    "package:extension": "node scripts/package-extension.mjs"
  },
  "keywords": [
    "review",
    "annotation",
    "html",
    "redline",
    "comments",
    "agent",
    "claude",
    "docs-review"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Blake Parsons",
  "repository": {
    "type": "git",
    "url": "https://github.com/bhparsons/redline"
  },
  "homepage": "https://github.com/bhparsons/redline"
}
